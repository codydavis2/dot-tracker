# Copy this file to .env and adjust for your machine:  cp .env.example .env
# .env is gitignored — never commit real secrets. Real environment variables
# override anything set here.

# Secret used by Flask to sign data. Any long random string works locally.
# Generate one with:  python3 -c "import secrets; print(secrets.token_hex(32))"
# Production MUST set its own value; the built-in fallback is for local dev only.
SECRET_KEY=change-me

# PostgreSQL connection for the app. Leave unset to use the local docker-compose
# database built from the POSTGRES_* values below (localhost:5432). Set it to point
# somewhere else, as a URL or key=value string, e.g.
#   postgresql://user:password@host:5432/dbname
# DATABASE_URL=

# Separate database used by pytest. ALL DATA IN IT IS WIPED on every test run, so
# never point it at a database you care about. Leave unset to use
# <POSTGRES_DB>_test on the local docker-compose server (created automatically).
# TEST_DATABASE_URL=

# Folder where work order attachments are stored. Relative paths are resolved
# from the project root. Keep this outside static/ so files are only served
# through the login-checked download route.
UPLOAD_DIR=uploads/work_orders

# Set to 1 to turn on Flask debug mode (auto-reload, in-browser tracebacks).
# Local development only — leave at 0 anywhere else. Debug is OFF unless this is 1.
FLASK_DEBUG=0

# --- PostgreSQL (docker-compose.yml) ---
# Credentials for the local Postgres container; the app connects with them too
# unless DATABASE_URL is set.
# The container is created with these credentials the first time it starts. Changing
# them later has no effect until you wipe the volume (docker compose down -v).
POSTGRES_USER=gladhand
# Local-only password. Pick something else if you like; never reuse it in production.
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gladhand

# --- Accounts and security ---
# How emails (password resets, invites) go out:
#   console — print them in the terminal running the app (default; nothing is sent).
#             Emailed links are also shown on screen, for local testing only.
#   ses     — Amazon SES. Not implemented yet (added at deploy time).
MAIL_BACKEND=console
# Sender address on outgoing email.
# MAIL_FROM=Gladhand <no-reply@example.com>

# Where rate-limit counters (login attempts etc.) are kept. memory:// is per-process
# and resets on restart; fine for one instance. With several instances use shared
# storage, e.g. redis://localhost:6379
# RATELIMIT_STORAGE_URI=memory://
