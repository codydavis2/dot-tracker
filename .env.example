# Copy this file to .env and adjust for your machine:  cp .env.example .env
# .env is gitignored — never commit real secrets. Real environment variables
# override anything set here.

# Secret used by Flask to sign data. Any long random string works locally.
# Generate one with:  python3 -c "import secrets; print(secrets.token_hex(32))"
# Production MUST set its own value; the built-in fallback is for local dev only.
SECRET_KEY=change-me

# Path to the SQLite database file. Relative paths are resolved from the
# project root (not from wherever you start the app).
DATABASE=dot_tracker.db

# Folder where work order attachments are stored. Relative paths are resolved
# from the project root. Keep this outside static/ so files are only served
# through the login-checked download route.
UPLOAD_DIR=uploads/work_orders

# Set to 1 to turn on Flask debug mode (auto-reload, in-browser tracebacks).
# Local development only — leave at 0 anywhere else. Debug is OFF unless this is 1.
FLASK_DEBUG=0

# --- PostgreSQL (docker-compose.yml) ---
# Used only by the local Postgres container for now; the app still runs on SQLite.
# The container is created with these credentials the first time it starts. Changing
# them later has no effect until you wipe the volume (docker compose down -v).
POSTGRES_USER=gladhand
# Local-only password. Pick something else if you like; never reuse it in production.
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gladhand
